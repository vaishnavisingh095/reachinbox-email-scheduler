# Copy this file to .env and fill in real values where noted.
# This is the complete list of environment variables documented in
# docs/architecture.md — no additional variables are introduced beyond it.

# --- Infrastructure (matches docker-compose.yml) ---
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5433/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# --- Scheduling / rate limiting (see docs/architecture.md) ---
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# --- Google OAuth (Phase 7) — placeholders, replace with real credentials ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Slack OAuth (Phase 8) — placeholders, replace with real credentials ---
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# --- Sessions / admin (Phase 7, Phase 10) ---
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=admin@example.com

# --- URLs ---
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
