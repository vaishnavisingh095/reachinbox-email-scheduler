# Copy this file to .env and fill in real values where noted.
# This is the complete list of environment variables documented in
# docs/architecture.md — no additional variables are introduced beyond it.

# --- Infrastructure (matches docker-compose.yml) ---
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5433/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# --- Scheduling / rate limiting (see docs/architecture.md) ---
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# --- Google OAuth ---
# Create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials, with an authorized
# redirect URI of {API_URL}/auth/google/callback (e.g.
# http://localhost:4000/auth/google/callback for local dev).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Slack OAuth ---
# Create a Slack app at https://api.slack.com/apps with the
# "incoming-webhook" OAuth scope, and a redirect URL of
# {API_URL}/auth/slack/callback (e.g. http://localhost:4000/auth/slack/callback).
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# --- Sessions / admin ---
# SESSION_SECRET signs the session cookie (ADR-012) — use a long random
# string in any real deployment. ADMIN_EMAILS is a comma-separated
# allow-list checked against the session's email for /admin/queues.
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=admin@example.com

# --- URLs ---
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
